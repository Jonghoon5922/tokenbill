SECRET_KEY=반드시-긴-랜덤-문자열로-바꾸세요
DATABASE_URL=sqlite:///./tokenbill.db
# 구글 로그인 (Google Cloud Console OAuth 클라이언트 ID)
GOOGLE_CLIENT_ID=
# 1이면 이메일/비밀번호를 막고 구글 로그인만 허용 (GOOGLE_CLIENT_ID 필요)
AUTH_GOOGLE_ONLY=
# 이 이메일 계정은 로그인 시 관리자로 자동 승격
ADMIN_EMAIL=
# 예산 알림 메일 발송 (Gmail이면 SMTP_PASS에 '앱 비밀번호')
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
